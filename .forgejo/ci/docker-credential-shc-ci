#!/usr/bin/env bash
# Docker en Cosign krijgen het pakketcredential alleen op aanvraag voor dit register.
set -eu
[[ "$1" == get ]]
read -r server || [[ -n $server ]]
[[ "$server" == "$SHC_REGISTRY_HOST" || "$server" == "https://$SHC_REGISTRY_HOST" ]]
: "${REGISTRY_USER:?REGISTRY_USER ontbreekt}" "${REGISTRY_TOKEN:?REGISTRY_TOKEN ontbreekt}"
jq -nc '{Username:env.REGISTRY_USER, Secret:env.REGISTRY_TOKEN}'
