{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"],
    "typeRoots": ["../../apps/web/node_modules/@types"],
    "baseUrl": ".",
    "paths": {
      "@playwright/test": ["../../apps/web/node_modules/@playwright/test"],
      "*": ["../../apps/web/node_modules/*"]
    }
  },
  "include": ["./*.ts"]
}
