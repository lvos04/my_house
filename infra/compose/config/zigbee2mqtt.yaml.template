# Generated by install.sh. Check `serial.adapter` for your dongle:
#   ember  = EFR32MG21/24 (e.g. SONOFF ZBDongle-E, SMLIGHT SLZB-07)
#   zstack = CC2652/CC1352 (e.g. SONOFF ZBDongle-P)
homeassistant:
  enabled: false
frontend:
  enabled: false
permit_join: false
mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://mosquitto:1883
  user: zigbee2mqtt
  password: '!secret.yaml mqtt_password'
serial:
  port: /dev/zigbee
  adapter: __ADAPTER__
advanced:
  network_key: GENERATE
  pan_id: GENERATE
  ext_pan_id: GENERATE
  log_level: info
  last_seen: ISO_8601
availability:
  enabled: true
device_options:
  retain: false
