# Generated by install.sh (only when configuration.yaml does not exist yet).
# Check `serial.adapter` for your dongle:
#   ember  = EFR32MG21/24 (e.g. SONOFF ZBDongle-E, SMLIGHT SLZB-07)
#   zstack = CC2652/CC1352 (e.g. SONOFF ZBDongle-P)
# Zigbee2MQTT replaces the GENERATE values with real keys on first start. Those keys live only
# here and are part of the app's backup: keep the backups.
version: 5
homeassistant:
  enabled: false
frontend:
  enabled: false
mqtt:
  base_topic: zigbee2mqtt
  server: mqtt://mosquitto:1883
  user: zigbee2mqtt
  password: '!secret.yaml mqtt_password'
serial:
  port: /dev/zigbee
  adapter: __ADAPTER__
advanced:
  network_key: GENERATE
  pan_id: GENERATE
  ext_pan_id: GENERATE
  log_level: info
  # Logs go to the container log (docker/TrueNAS), not into the data folder and the backups.
  log_output:
    - console
  last_seen: ISO_8601
availability:
  enabled: true
device_options:
  retain: false
